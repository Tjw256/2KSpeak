<Window x:Class="TwoKSpeak.App.Ui.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="2KSpeak Setup"
        Style="{StaticResource AppWindow}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Text="Setting up 2KSpeak" />
        <TextBlock Margin="0,8,0,0" Style="{StaticResource Hint}" FontSize="13" Foreground="{StaticResource Text2}"
                   Text="2KSpeak types what you say. Speech recognition runs on this PC, so it needs a few one-time downloads. Your voice never leaves your computer." />

        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <StackPanel x:Name="Rows" />
        </Border>

        <DockPanel Margin="4,14,0,0">
            <Button x:Name="RetryButton" DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Margin="12,0,0,0"
                    VerticalAlignment="Top" Content="Try again" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" FontSize="13" Foreground="{StaticResource Text1}" />
        </DockPanel>

        <TextBlock x:Name="NextStepText" Margin="4,10,0,0" Style="{StaticResource Hint}" FontSize="13" />

        <Button x:Name="CloseButton" Margin="0,20,0,0" HorizontalAlignment="Right" Style="{StaticResource PlainButton}"
                MinWidth="96" Content="Close" IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>
