<Window x:Class="TwoKSpeak.App.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">
    <Border Background="#090909"
            BorderBrush="#1B1B1B"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,8">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center" Fill="#FF5C62" />
            <TextBlock x:Name="Message"
                       Margin="10,0,0,0"
                       MaxWidth="520"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="13"
                       Foreground="#ABABAB"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
