<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TwoKSpeak.Bench</RootNamespace>
    <AssemblyName>2KSpeak.Bench</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TwoKSpeak.Engine\TwoKSpeak.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Condition="'$(OrtFlavor)' == 'Cuda'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" Version="$(OrtVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(OrtFlavor)' == 'DirectML'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="$(OrtVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(OrtFlavor)' == 'Cpu'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OrtVersion)" />
  </ItemGroup>
</Project>
